.mobile-chat
  --ai-bg: #f4f5f7
  --ai-surface: #ffffff
  --ai-text: #111827
  --ai-muted: #6b7280
  --ai-line: rgba(17, 24, 39, 0.08)
  --ai-accent: #0f766e
  font-family 'Plus Jakarta Sans', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif
  -webkit-font-smoothing antialiased
  background var(--ai-bg)
  color var(--ai-text)

  .chat-topbar
    display flex
    align-items center
    gap 8px
    height 52px
    padding 0 12px
    background rgba(255, 255, 255, 0.94)
    border-bottom 1px solid var(--ai-line)
    backdrop-filter blur(14px)
    -webkit-backdrop-filter blur(14px)

  .chat-topbar__btn
    flex-shrink 0
    display flex
    align-items center
    justify-content center
    width 36px
    height 36px
    padding 0
    border none
    border-radius 12px
    background transparent
    color #374151
    cursor pointer
    -webkit-tap-highlight-color transparent
    &:active
      background #f3f4f6

  .chat-topbar__model
    flex 1
    min-width 0
    display inline-flex
    align-items center
    justify-content center
    gap 6px
    height 36px
    padding 0 12px
    border none
    border-radius 999px
    background #f3f4f6
    color var(--ai-text)
    cursor pointer
    -webkit-tap-highlight-color transparent

  .chat-topbar__web-pill
    flex-shrink 0
    padding 2px 6px
    border-radius 6px
    font-size 10px
    font-weight 700
    letter-spacing 0.03em
    color #0369a1
    background rgba(14, 165, 233, 0.14)

  .chat-topbar__model-name
    max-width 100%
    overflow hidden
    text-overflow ellipsis
    white-space nowrap
    font-size 14px
    font-weight 700
    letter-spacing (-0.01em)

  .chat-topbar__right
    display flex
    align-items center
    gap 2px
    flex-shrink 0

  .message-list-box
    padding-top 8px
    padding-bottom 12px
    overflow-x hidden
    background var(--ai-bg)

    .van-cell
      background none
      padding 6px 14px
      font-family inherit
      align-items flex-start

    .van-cell__value
      text-align left
      overflow visible

    .message-line
      max-width 720px
      margin 0 auto
      width 100%

    .message-line + .message-line
      margin-top 2px

    .chat-empty-wrap
      display flex
      align-items center
      justify-content center
      min-height 58vh
      padding 28px 20px 40px
      box-sizing border-box

    .chat-empty-card
      width 100%
      max-width 480px
      padding 8px 6px
      text-align center
      background transparent
      border none
      box-shadow none

    .chat-empty-mark
      width 52px
      height 52px
      margin 0 auto 16px
      border-radius 16px
      display flex
      align-items center
      justify-content center
      font-size 14px
      font-weight 800
      letter-spacing 0.04em
      color #fff
      background: linear-gradient(145deg, #0f766e 0%, #0d9488 55%, #2563eb 100%)
      box-shadow 0 8px 20px rgba(15, 118, 110, 0.28)

    .chat-empty-title
      margin 0
      font-size 22px
      font-weight 800
      letter-spacing (-0.02em)
      color var(--ai-text)
      line-height 1.3

    .chat-empty-desc
      margin 10px 0 0
      font-size 14px
      line-height 1.55
      color var(--ai-muted)

    .chat-empty-model
      margin 14px 0 0
      font-size 12px
      font-weight 600
      color var(--ai-accent)
      background rgba(15, 118, 110, 0.1)
      display inline-block
      padding 4px 12px
      border-radius 999px

    .chat-empty-tpl
      margin-top 24px
      text-align left
      width 100%

      &__head
        display flex
        align-items baseline
        justify-content space-between
        gap 8px
        margin-bottom 12px

      &__label
        font-size 15px
        font-weight 800
        color var(--ai-text)
        letter-spacing (-0.02em)

      &__hint
        font-size 11px
        font-weight 500
        color var(--ai-muted)
        text-align right
        flex-shrink 0

      &__grid
        display grid
        grid-template-columns 1fr 1fr
        gap 10px

      &__card
        display flex
        align-items flex-start
        gap 10px
        margin 0
        padding 12px 11px
        border 1px solid var(--ai-line)
        border-radius 16px
        background var(--ai-surface)
        box-shadow 0 2px 8px rgba(17, 24, 39, 0.05)
        cursor pointer
        text-align left
        font-family inherit
        -webkit-tap-highlight-color transparent
        transition transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease
        &:active
          transform scale(0.98)
          box-shadow 0 1px 4px rgba(17, 24, 39, 0.06)

      &__icon
        flex-shrink 0
        display flex
        align-items center
        justify-content center
        width 36px
        height 36px
        border-radius 11px

      &__text
        flex 1
        min-width 0
        display flex
        flex-direction column
        gap 3px

      &__name
        font-size 13px
        font-weight 700
        color #111827
        line-height 1.35

      &__desc
        font-size 11px
        font-weight 500
        color #6b7280
        line-height 1.35

      &__card--coral .chat-empty-tpl__icon
        color #e11d48
        background rgba(225, 29, 72, 0.1)
      &__card--indigo .chat-empty-tpl__icon
        color #4f46e5
        background rgba(79, 70, 229, 0.1)
      &__card--sky .chat-empty-tpl__icon
        color #0284c7
        background rgba(2, 132, 199, 0.1)
      &__card--teal .chat-empty-tpl__icon
        color #0f766e
        background rgba(15, 118, 110, 0.1)
      &__card--slate .chat-empty-tpl__icon
        color #475569
        background rgba(71, 85, 105, 0.1)
      &__card--amber .chat-empty-tpl__icon
        color #d97706
        background rgba(217, 119, 6, 0.1)
      &__card--green .chat-empty-tpl__icon
        color #059669
        background rgba(5, 150, 105, 0.1)
      &__card--purple .chat-empty-tpl__icon
        color #7c3aed
        background rgba(124, 58, 237, 0.1)

      &__card--coral:active
        border-color rgba(225, 29, 72, 0.25)
      &__card--indigo:active
        border-color rgba(79, 70, 229, 0.25)
      &__card--sky:active
        border-color rgba(2, 132, 199, 0.25)

  .model-picker-panel
    padding 12px 16px 24px
    max-height 60vh
    overflow-y auto
    background var(--ai-surface)

  .model-picker-header
    display flex
    align-items center
    justify-content space-between
    margin-bottom 12px

  .model-picker-title
    font-size 16px
    font-weight 700
    color var(--ai-text)

  .model-picker-close
    font-size 18px
    color var(--ai-muted)
    padding 4px

  .model-picker-item
    display flex
    align-items center
    justify-content space-between
    padding 14px 12px
    margin-bottom 8px
    border-radius 14px
    background #f9fafb
    border 1px solid transparent

    &.active
      background rgba(15, 118, 110, 0.08)
      border-color rgba(15, 118, 110, 0.28)

    &:active
      opacity 0.85

  .model-picker-item-main
    display flex
    flex-direction column
    align-items flex-start
    gap 4px
    min-width 0

  .model-picker-name
    font-size 15px
    font-weight 600
    color var(--ai-text)

  .model-picker-power
    font-size 12px
    color var(--ai-muted)

  .model-picker-empty
    text-align center
    padding 24px
    color var(--ai-muted)
    font-size 14px

  .chat-box-wrapper
    background: linear-gradient(180deg, rgba(244, 245, 247, 0) 0%, var(--ai-bg) 28%, var(--ai-bg) 100%)

  .history-popup
    display flex
    flex-direction column
    height 100%
    background var(--ai-surface)
    color var(--ai-text)

  .history-container
    display flex
    flex-direction column
    height 100%
    min-height 0

  .history-header-panel
    flex-shrink 0
    padding 14px 14px 12px
    background var(--ai-surface)
    border-bottom 1px solid var(--ai-line)

  .history-brand-row
    display flex
    align-items center
    justify-content space-between
    gap 8px
    margin-bottom 12px

  .history-brand
    display flex
    align-items center
    gap 10px
    min-width 0

  .history-brand__mark
    flex-shrink 0
    width 34px
    height 34px
    border-radius 11px
    display flex
    align-items center
    justify-content center
    font-size 11px
    font-weight 800
    color #fff
    background: linear-gradient(145deg, #0f766e 0%, #2563eb 100%)

  .history-brand__title
    font-size 16px
    font-weight 800
    letter-spacing (-0.02em)
    color var(--ai-text)

  .history-close-btn
    display flex
    align-items center
    justify-content center
    width 32px
    height 32px
    padding 0
    border none
    border-radius 10px
    background #f3f4f6
    color #4b5563
    cursor pointer
    flex-shrink 0
    .van-icon
      font-size 16px

  .history-new-btn
    display flex
    align-items center
    justify-content center
    gap 6px
    width 100%
    margin 0 0 12px
    padding 0
    height 42px
    border none
    border-radius 12px
    background #111827
    color #fff
    font-size 14px
    font-weight 700
    line-height 1
    box-shadow 0 8px 20px rgba(17, 24, 39, 0.16)
    cursor pointer
    -webkit-tap-highlight-color transparent
    .van-icon
      font-size 16px
      color #fff
    &:active
      opacity 0.9
      transform scale(0.99)

  .history-search
    padding 0
    background transparent
    .van-search__content
      background #f3f4f6
      border-radius 12px

  .history-content
    flex 1
    min-height 0
    overflow-y auto
    -webkit-overflow-scrolling touch
    padding 10px 10px 12px

  .history-empty
    padding-top 48px

  .history-list
    padding 0

  .history-item-wrapper
    margin-bottom 4px
    border-radius 12px
    overflow hidden

  .history-item
    display flex
    align-items center
    gap 8px
    padding 12px 10px
    background transparent
    border-radius 12px
    transition background 0.15s ease
    &.is-active
      background #f3f4f6
      box-shadow inset 3px 0 0 #0f766e
    &:active
      background #f3f4f6

  .history-item-body
    flex 1
    min-width 0

  .history-chat-title
    font-size 14px
    font-weight 600
    color var(--ai-text)
    line-height 1.4

  .history-chat-subtitle
    margin-top 3px
    font-size 12px
    color var(--ai-muted)
    line-height 1.3

  .history-delete-icon
    flex-shrink 0
    padding 8px
    font-size 16px
    color #c8c9cc
    &:active
      color #ee0a24

  .history-swipe-delete
    height 100%

  .history-footer
    flex-shrink 0
    padding 10px 14px calc(12px + env(safe-area-inset-bottom, 0px))
    border-top 1px solid var(--ai-line)
    background var(--ai-surface)

  .history-footer-btn
    display flex
    align-items center
    gap 8px
    width 100%
    padding 10px 12px
    border none
    border-radius 12px
    background #f9fafb
    color #374151
    font-size 13px
    font-weight 600
    cursor pointer
    -webkit-tap-highlight-color transparent
    &:active
      background #f3f4f6

  .model-selector
    background linear-gradient(180deg, rgba(244, 245, 247, 0) 0%, var(--ai-bg) 40%)
    border-top 1px solid var(--ai-line)
    padding 10px 12px 6px

  .model-scroll
    display flex
    flex-wrap nowrap
    overflow-x auto
    -webkit-overflow-scrolling touch
    gap 8px
    padding-bottom 2px
    scrollbar-width none
    &::-webkit-scrollbar
      display none

  .model-chip
    display inline-flex
    align-items center
    padding 7px 13px
    margin-right 0
    border-radius 999px
    background var(--ai-surface)
    border 1px solid var(--ai-line)
    font-size 12px
    font-weight 600
    white-space nowrap
    color #4b5563
    cursor pointer
    box-shadow 0 1px 2px rgba(17, 24, 39, 0.05)
    transition background 0.15s ease, border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease

  .model-chip.active
    background #111827
    border-color #111827
    color #ffffff
    box-shadow 0 4px 14px rgba(17, 24, 39, 0.22)

  .model-name
    margin-right 2px

  .model-power
    font-size 11px
    opacity 0.8

  .composer
    padding 8px 12px 10px

  .composer__web-search
    padding 2px 0 0
    margin-bottom 6px

    &--on
      margin-bottom 4px

  .web-search-chip
    position relative
    display inline-flex
    align-items center
    gap 6px
    padding 7px 13px
    border-radius 999px
    border 1px solid var(--ai-line)
    background var(--ai-surface)
    font-size 12px
    font-weight 600
    color #4b5563
    box-shadow 0 1px 2px rgba(17, 24, 39, 0.05)
    cursor pointer
    -webkit-tap-highlight-color transparent

    &.active
      border-color rgba(14, 165, 233, 0.45)
      color #0369a1
      background linear-gradient(135deg, rgba(14, 165, 233, 0.1) 0%, rgba(16, 163, 127, 0.08) 100%)
      box-shadow 0 2px 10px rgba(14, 165, 233, 0.15)

    &__pulse
      width 7px
      height 7px
      border-radius 50%
      background #0ea5e9
      animation web-search-pulse 1.6s ease-in-out infinite

    &__label
      max-width 220px
      overflow hidden
      text-overflow ellipsis
      white-space nowrap

  @keyframes web-search-pulse
    0%, 100%
      opacity 1
      transform scale(1)
    50%
      opacity 0.55
      transform scale(0.92)

  .composer__tools
    display flex
    gap 8px
    margin-bottom 8px

  .composer__tool
    display inline-flex
    align-items center
    gap 4px
    padding 6px 10px
    border none
    border-radius 999px
    background var(--ai-surface)
    border 1px solid var(--ai-line)
    color #4b5563
    font-size 12px
    font-weight 600
    cursor pointer
    -webkit-tap-highlight-color transparent
    &:active
      background #f3f4f6

  .composer__shell
    display flex
    align-items flex-end
    gap 10px
    padding 10px 10px 10px 14px
    border-radius 22px
    background var(--ai-surface)
    border 1px solid var(--ai-line)
    box-shadow 0 1px 3px rgba(17, 24, 39, 0.04), 0 8px 24px rgba(17, 24, 39, 0.04)

  .composer__textarea
    flex 1
    min-width 0
    min-height 24px
    max-height 150px
    margin 0
    padding 6px 0
    border none
    outline none
    resize none
    background transparent
    font-size 15px
    line-height 1.5
    color var(--ai-text)
    font-family inherit
    -webkit-font-smoothing antialiased
    &::placeholder
      color #9ca3af

  .composer__send
    flex-shrink 0
    display flex
    align-items center
    justify-content center
    width 36px
    height 36px
    padding 0
    border none
    border-radius 50%
    background #111827
    color #fff
    cursor pointer
    transition background 0.2s ease, transform 0.15s ease, opacity 0.2s ease
    -webkit-tap-highlight-color transparent
    &:disabled
      background #d1d5db
      color #fff
      cursor not-allowed
    &:not(:disabled):active
      transform scale(0.94)

    &--stop
      background #111827
      &:disabled
        background #111827
        opacity 1
        cursor pointer

  .composer__send-square
    display block
    width 11px
    height 11px
    border-radius 2px
    background #fff

.van-overlay
  .mic-wrapper
    display flex
    height 100vh
    justify-content center
    align-items center
    flex-flow column
