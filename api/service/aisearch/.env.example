# AI搜侧车（GramJS / 极搜）
# 复制为 .env 后填写

AISEARCH_PORT=5690
AISEARCH_PUBLIC_URL_PREFIX=/api/ai-search/files
AISEARCH_MEDIA_STORAGE=r2

# Cloudflare R2
MEDIA_STORAGE=r2
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------- 搜索专用（极搜）— session.txt ----------
TG_API_ID=
TG_API_HASH=
TG_PHONE=+86xxxxxxxxxxx
TG_SESSION_FILE=./collector/session.txt

# ---------- 播放专用（媒体流）— back.txt ----------
# 与搜索不同 App / 手机号时必填下面三项，否则会用搜索号凭证开媒体 session（易 AUTH 失败）
TG_MEDIA_API_ID=
TG_MEDIA_API_HASH=
TG_MEDIA_PHONE=
TG_MEDIA_SESSION_FILE=./collector/back.txt

# 极搜 Bot
JISOU_BOT_USERNAME=jisou
JISOU_CAPTCHA_MODE=web
JISOU_CAPTCHA_CHALLENGE_TTL_MS=120000
